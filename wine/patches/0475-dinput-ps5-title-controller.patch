--- a/dlls/dinput/Makefile.in
+++ b/dlls/dinput/Makefile.in
@@ -16,5 +16,6 @@ SOURCES = \
 	dinput_classes.idl \
 	dinput_main.c \
 	joystick_hid.c \
+	joystick_ps5.c \
 	keyboard.c \
