--- a/dlls/dinput/dinput_private.h
+++ b/dlls/dinput/dinput_private.h
@@ -59,6 +59,11 @@ extern HRESULT hid_joystick_create_device( struct dinput *dinput, const GUID *gu
 extern HRESULT hid_joystick_refresh_devices(void);
 extern void hid_joystick_cleanup_devices(void);
 
+extern const WCHAR ps5_joystick_path[];
+extern BOOL ps5_joystick_get_instance( DIDEVICEINSTANCEW *instance );
+extern HRESULT ps5_joystick_create_device( struct dinput *dinput, const GUID *guid, const DIDEVICEINSTANCEW *instance,
+                                           DWORD joy_id, IDirectInputDevice8W **out );
+
 struct DevicePlayer {
     GUID instance_guid;
     WCHAR username[MAX_PATH];
diff --git a/dlls/dinput/joystick_hid.c b/dlls/dinput/joystick_hid.c
--- a/dlls/dinput/joystick_hid.c
+++ b/dlls/dinput/joystick_hid.c
@@ -1864,6 +1864,7 @@ HRESULT hid_joystick_refresh_devices(void)
     static const WCHAR *dinput_path = L"System\\CurrentControlSet\\Control\\MediaProperties\\"
                                        "PrivateProperties\\DirectInput";
 
+    DIDEVICEINSTANCEW ps5_instance;
     WCHAR *paths = NULL;
     HANDLE device;
     HANDLE mutex;
@@ -1901,6 +1902,13 @@ HRESULT hid_joystick_refresh_devices(void)
     }
     free( paths );
 
+    /* A PS5 title has no HID stack: its controller is listed from the title's sink. */
+    if (ps5_joystick_get_instance( &ps5_instance ))
+    {
+        ps5_instance.guidInstance = create_instance_uuid();
+        if (SUCCEEDED(insert_cache_entry( &ps5_instance, MAX_JOY_ID + 1, ps5_joystick_path ))) hr = DI_OK;
